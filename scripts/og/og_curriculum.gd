extends RefCounted
class_name OGCurriculum

## Read-only access to the OG scope and sequence (stages, zones, words).
## The data itself lives in og_data.gd, generated by
## tools/curriculum/curriculum.py - edit the Python file, not the data.

const Data := preload("res://scripts/og/og_data.gd")

const BAND_NAMES := {
	"A": "Sounds (oral)",
	"B": "Letters & sounds",
	"C": "Closed syllables",
	"D": "Vowel patterns",
	"E": "Multisyllable words",
	"F": "Morphemes",
	"H": "Heart words",
	"R": "Fluency",
}

## Stage ids that make up the main sequence (gated, in teaching order).
static func sequence() -> Array:
	var out: Array = []
	for s in Data.STAGES:
		if int(s["zone"]) >= 0:
			out.append(String(s["id"]))
	return out


static func stage(stage_id: String) -> Dictionary:
	for s in Data.STAGES:
		if String(s["id"]) == stage_id:
			return s
	return {}


static func has_stage(stage_id: String) -> bool:
	return not stage(stage_id).is_empty()


static func stage_index(stage_id: String) -> int:
	return sequence().find(stage_id)


## The stage taught right before `stage_id`, or "" for the very first one.
static func previous_stage(stage_id: String) -> String:
	var seq := sequence()
	var i := seq.find(stage_id)
	if i <= 0:
		return ""
	return String(seq[i - 1])


static func next_stage(stage_id: String) -> String:
	var seq := sequence()
	var i := seq.find(stage_id)
	if i < 0 or i >= seq.size() - 1:
		return ""
	return String(seq[i + 1])


static func zone_count() -> int:
	return Data.ZONES.size()


static func zone(zone_id: int) -> Dictionary:
	for z in Data.ZONES:
		if int(z["id"]) == zone_id:
			return z
	return Data.ZONES[0]


static func zone_stages(zone_id: int) -> Array:
	return zone(zone_id).get("stages", []).duplicate()


static func zone_of_stage(stage_id: String) -> int:
	return int(stage(stage_id).get("zone", 0))


static func band_of(stage_id: String) -> String:
	return String(stage(stage_id).get("band", "A"))


static func band_rank(band: String) -> int:
	return "ABCDEFHR".find(band)


static func words(stage_id: String) -> Array:
	return Data.WORDS.get(stage_id, []).duplicate()


## Every entry from every stage - used to find audio partners and distractors.
static func all_words() -> Array:
	var out: Array = []
	for sid in Data.WORDS.keys():
		out.append_array(Data.WORDS[sid])
	return out


## Heart words that belong to bands up to and including `band`.
static func heart_words_up_to(band: String) -> Array:
	var out: Array = []
	var limit := band_rank(band)
	for e in Data.WORDS.get("H1", []):
		if band_rank(String(e.get("band", "B"))) <= limit:
			out.append(e)
	return out


static func sentences_up_to(band: String) -> Array:
	var out: Array = []
	var limit := band_rank(band)
	for s in Data.SENTENCES:
		if band_rank(String(s["band"])) <= limit:
			out.append(s)
	return out


static func label(stage_id: String) -> String:
	var s := stage(stage_id)
	if s.is_empty():
		return stage_id
	return "%s · %s" % [stage_id, String(s["name"])]

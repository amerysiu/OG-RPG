extends RefCounted

## LEGACY compatibility layer.
##
## The word data now lives in the OG curriculum (scripts/og/og_data.gd,
## generated by tools/curriculum/curriculum.py) and questions are built by
## QuestionFactory. This file keeps the old API alive for the older scenes
## (MainGameManager, battle_scene, minigame_word_build, combat_arena) so they
## still compile and draw from the corrected word bank.
##
## Old "levels" map onto OG stages: 1 = C1 (CVC), 2 = C2 (digraphs),
## 3 = C4 (blends), 4+ = later closed-syllable stages.

const LEGACY_LEVEL_STAGE := {1: "C1", 2: "C2", 3: "C4", 4: "C5", 5: "C6"}

static var WORDS: Array = _legacy_words()


static func _legacy_words() -> Array:
	var out: Array = []
	for level in LEGACY_LEVEL_STAGE.keys():
		for e in OGCurriculum.words(String(LEGACY_LEVEL_STAGE[level])):
			var d: Dictionary = e.duplicate()
			d["level"] = int(level)
			d["pattern"] = String(OGCurriculum.stage(String(LEGACY_LEVEL_STAGE[level])).get("name", ""))
			out.append(d)
	return out


static func _stage_for_level(level: int) -> String:
	return String(LEGACY_LEVEL_STAGE.get(clampi(level, 1, 5), "C1"))


static func words_for_level(level: int) -> Array:
	var out: Array = []
	for e in WORDS:
		if int(e["level"]) == level:
			out.append(e)
	return out


static func level_focus(level: int) -> String:
	return String(OGCurriculum.stage(_stage_for_level(level)).get("name", "review words"))


static func pick_word(level: int, exclude: Array = []) -> Dictionary:
	var all := words_for_level(level)
	if all.is_empty():
		all = WORDS.duplicate()
	var pool: Array = all.filter(func(e): return not exclude.has(String(e["word"])))
	if pool.is_empty():
		pool = all
	return pool[randi() % pool.size()]


static func tile_pool(entry: Dictionary, distractor_count: int = 4) -> Array:
	return QuestionFactory._tile_pool(entry, String(entry.get("stage", "C1")), distractor_count, {})


static func answer(entry: Dictionary) -> String:
	var joined := ""
	for tile in entry.get("tiles", []):
		joined += String(tile)
	return joined


## Old zones: 1 = letters (B), 2 = closed syllables (C), 3 = long words (E/F).
static func words_for_zone(zone_id: int) -> Array:
	match zone_id:
		1:
			return OGCurriculum.words("B1") + OGCurriculum.words("B2")
		3:
			return OGCurriculum.words("E2") + OGCurriculum.words("F3")
		_:
			return words_for_level(1) + words_for_level(2)


static func pick_word_for_zone(zone_id: int, monster_level: int, exclude: Array = [], _max_level: int = 99) -> Dictionary:
	var pool := words_for_zone(zone_id)
	if zone_id == 2:
		pool = words_for_level(clampi(monster_level - 5, 1, 3))
	var filtered: Array = pool.filter(func(e): return not exclude.has(String(e["word"])))
	if filtered.is_empty():
		filtered = pool
	if filtered.is_empty():
		filtered = WORDS
	return filtered[randi() % filtered.size()]


static func phoneme_bank() -> Dictionary:
	return QuestionFactory._phoneme_bank()


static func is_vowel_grapheme(grapheme: String) -> bool:
	return grapheme.to_lower() in ["a", "e", "i", "o", "u", "ai", "ay", "ee", "ea", "oa", "ow", "ie", "igh", "oi", "oy", "ou", "aw", "au", "oo"]


static func is_which_spelling_k(entry: Dictionary) -> bool:
	var tiles: Array = entry.get("tiles", [])
	return not tiles.is_empty() and String(tiles[tiles.size() - 1]).to_lower() in ["c", "k", "ck"]


static func which_spelling_k_answer(entry: Dictionary) -> String:
	var tiles: Array = entry.get("tiles", [])
	return "" if tiles.is_empty() else String(tiles[tiles.size() - 1]).to_lower()


static func chain_partner(entry: Dictionary, exclude: Array = []) -> Dictionary:
	var stage := String(entry.get("stage", "C1"))
	for other in OGCurriculum.words(stage):
		if other["word"] == entry["word"] or exclude.has(String(other["word"])):
			continue
		if QuestionFactory._diff_positions(entry, other).size() == 1:
			return other
	return entry
